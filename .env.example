# Copy this file to .env and fill in the empty values

# --- Keycloak database (PostgreSQL) ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=

# --- Keycloak first admin account (master realm) ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# --- Nextcloud local admin (break-glass) ---
NC_ADMIN_USER=nc-admin
NC_ADMIN_PASSWORD=

# --- Grafana ---
GF_ADMIN_USER=grafana-admin
GF_ADMIN_PASSWORD=
# Keycloak > Clients > grafana > Credentials > Client secret
GF_OAUTH_CLIENT_SECRET=
